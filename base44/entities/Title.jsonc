{
  "name": "Title",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Account identifier"
    },
    "title": {
      "type": "string",
      "description": "Book/content title"
    },
    "subtitle": {
      "type": "string",
      "description": "Book subtitle"
    },
    "isbn": {
      "type": "string",
      "description": "ISBN identifier"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "description": "Book contributors (authors, illustrators, etc.)"
    },
    "author": {
      "type": "string",
      "description": "Primary author name"
    },
    "publisher": {
      "type": "string",
      "description": "Publisher name"
    },
    "imprint": {
      "type": "string",
      "description": "Publisher imprint"
    },
    "series_name": {
      "type": "string",
      "description": "Name of the series the book belongs to"
    },
    "series_number": {
      "type": "number",
      "description": "Series sequence number"
    },
    "activation_date": {
      "type": "string",
      "format": "date",
      "description": "Date when title was activated (on sale date)"
    },
    "publication_date": {
      "type": "string",
      "format": "date",
      "description": "Publication date"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    },
    "countries_included": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Countries where the title is available"
    },
    "countries_excluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Countries where the title is excluded"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "draft"
      ],
      "default": "draft",
      "description": "Publishing status"
    },
    "language": {
      "type": "string",
      "description": "Primary language of the content"
    },
    "category_type": {
      "type": "string",
      "description": "Category classification type"
    },
    "category_code": {
      "type": "string",
      "description": "Category code"
    },
    "is_preorder": {
      "type": "boolean",
      "default": false,
      "description": "Whether the title is available for pre-order"
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "description": "Pricing information by region"
    },
    "description": {
      "type": "string",
      "description": "Book description"
    },
    "genre": {
      "type": "string",
      "description": "Book genre/category"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords or tags for the title"
    },
    "accessibility_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accessibility features"
    },
    "region": {
      "type": "string",
      "enum": [
        "global",
        "us",
        "ca",
        "uk",
        "au",
        "fr",
        "de",
        "jp"
      ],
      "default": "global",
      "description": "Primary available region"
    },
    "pre_order_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the title is available for pre-order"
    },
    "preview_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether preview is enabled"
    },
    "kobo_plus_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the title is available in Kobo Plus"
    },
    "annotation_export_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether annotation export is enabled"
    },
    "ai_recaps_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether AI recaps are enabled"
    },
    "price": {
      "type": "number",
      "description": "Base price of the title"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Price currency"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "sales_count": {
      "type": "number",
      "default": 0,
      "description": "Total sales count"
    },
    "revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue"
    }
  },
  "required": [
    "title",
    "author",
    "status"
  ]
}